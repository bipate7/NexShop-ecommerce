{
  "name": "nexshop-api",
  "version": "0.1.0",
  "description": "Simple API for NexShop to serve product data during frontend development",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --runInBand --detectOpenHandles",
    "audit:pa11y": "pa11y-ci",
    "audit:lighthouse": "lighthouse http://localhost:3000 --output html --output-path ./artifacts/lighthouse-report.html"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "lighthouse": "^13.0.1",
    "nodemon": "^2.0.22",
    "pa11y-ci": "^4.0.1",
    "supertest": "^7.1.4"
  }
}
